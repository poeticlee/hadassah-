# Normalise line endings: LF in the repository, on every platform.
* text=auto eol=lf

*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
*.toml text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
